{
  // Local-only Worker config used by `npm run api:mock`.
  //
  // It mirrors wrangler.jsonc (wrangler 4 does not support `extends`) with one
  // difference: FREEBUFF_ISSUER points at dev/mock-issuer.mjs, so the signed-in
  // flow runs end to end without reaching freebuff.com. Keep the other fields
  // in step with wrangler.jsonc; the deployed Worker never reads this file.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saken",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "saken",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "FREEBUFF_CLIENT_ID": "315076cd-6bff-4e31-9286-a5a4e8ce45b4",
    "FREEBUFF_ISSUER": "http://127.0.0.1:8790",
    "APP_ORIGIN": "http://localhost:5183"
  }
}
