{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saken",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  // Better Auth uses node:crypto and AsyncLocalStorage, which need the flag
  // before compatibility date 2026-08-04.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "saken",
      "database_id": "a5e1c156-60e7-4666-87ba-2c28df9bfed5"
    }
  ],
  // APP_ORIGIN is the public origin of the site. It must match the origin the
  // browser uses, because Better Auth uses it as baseURL and for trustedOrigins.
  // Locally, set it to http://localhost:5183 in .dev.vars.
  //
  // BETTER_AUTH_SECRET is deliberately absent here: it is a secret, so it lives
  // in .dev.vars for development and in `wrangler secret put` in Cloudflare.
  "vars": {
    "APP_ORIGIN": "https://saken.saken-dz.workers.dev"
  }
}
