{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saken",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "saken",
      "database_id": "a5e1c156-60e7-4666-87ba-2c28df9bfed5"
    }
  ],
  "vars": {
    "FREEBUFF_CLIENT_ID": "315076cd-6bff-4e31-9286-a5a4e8ce45b4",
    "FREEBUFF_ISSUER": "https://freebuff.com/oidc",
    "APP_ORIGIN": "http://localhost:5183"
  }
}
